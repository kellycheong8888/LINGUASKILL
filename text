        // ============================================================
        //  19. SPEECH RECOGNITION
        // ============================================================

        function startSpeechRecognition(phaseKey) {
            stopSpeechRecognition();
            if (!window.SpeechRecognition && !window.webkitSpeechRecognition) {
                showSpeechStatus('ℹ️ Speech recognition not available', 'idle');
                return;
            }

            const stream = getAudioStream();
            if (!stream) { showSpeechStatus('ℹ️ No microphone stream', 'idle'); return; }

            try {
                const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
                const recognition = new SR();
                try { recognition.lang = 'en-US'; } catch (e) { try { recognition.lang = 'en'; } catch (e2) {} }
                recognition.continuous = true;
                recognition.interimResults = true;
                recognition.maxAlternatives = 1;
                STATE.recognition = recognition;
                let finalTranscript = '';
                const textarea = document.querySelector('.speech-box textarea');

                recognition.onresult = (event) => {
                    let interim = '';
                    for (let i = event.resultIndex; i < event.results.length; i++) {
                        const t = event.results[i][0].transcript;
                        if (event.results[i].isFinal) { finalTranscript += t + ' '; } else { interim += t; }
                    }
                    if (textarea) {
                        textarea.value = finalTranscript + (interim ? '[' + interim + ']' : '');
                        textarea.scrollTop = textarea.scrollHeight;
                    }
                };

                recognition.onerror = (event) => {
                    if (event.error === 'language-not-supported') {
                        console.warn('Speech recognition: language not supported');
                        showSpeechStatus('ℹ️ Transcription not available', 'idle');
                        return;
                    }
                    if (event.error === 'not-allowed') {
                        showSpeechStatus('❌ Microphone denied', 'idle');
                    }
                    if (event.error !== 'not-allowed' && STATE.subPhase === 'speaking') {
                        setTimeout(() => {
                            if (STATE.subPhase === 'speaking' && !STATE.isRecording) {
                                startSpeechRecognition(phaseKey);
                            }
                        }, 500);
                    }
                };

                recognition.onend = () => {
                    STATE.isRecording = false;
                    if (STATE.subPhase === 'speaking' && !STATE.hasAutoAdvanced) {
                        setTimeout(() => {
                            if (STATE.subPhase === 'speaking' && !STATE.isRecording) {
                                startSpeechRecognition(phaseKey);
                            }
                        }, 300);
                    }
                };

                recognition.start();
                STATE.isRecording = true;
                showSpeechStatus('🔴 Recording...', 'recording');
            } catch (e) { console.warn('Speech recognition setup failed:', e);
                showSpeechStatus('ℹ️ Transcription not available', 'idle'); }
        }

        function stopSpeechRecognition() {
            if (STATE.recognition) { try { STATE.recognition.stop(); } catch (e) {} STATE.recognition = null; }
            STATE.isRecording = false;
        }

        function showSpeechStatus(text, type) {
            const statusEl = document.getElementById('recordStatus');
            if (statusEl) { statusEl.textContent = text;
                statusEl.className = 'record-status-text ' + (type || 'idle'); }
        }

        // ============================================================
        //  20. TTS & STOP ALL
        // ============================================================

        function playTTS(text) {
            return new Promise((resolve, reject) => {
                if (!window.speechSynthesis) { reject(new Error('TTS not supported')); return; }
                if (STATE.ttsUtterance) window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-US';
                utterance.rate = 0.85;
                utterance.pitch = 1.0;
                utterance.volume = 1;
                STATE.ttsUtterance = utterance;
                STATE.isTTSPlaying = true;
                utterance.onend = () => { STATE.isTTSPlaying = false;
                    STATE.ttsUtterance = null;
                    resolve(); };
                utterance.onerror = () => { STATE.isTTSPlaying = false;
                    STATE.ttsUtterance = null;
                    reject(new Error('TTS error')); };
                window.speechSynthesis.speak(utterance);
                setTimeout(() => {
                    if (STATE.isTTSPlaying) {
                        window.speechSynthesis.cancel();
                        STATE.isTTSPlaying = false;
                        STATE.ttsUtterance = null;
                        resolve();
                    }
                }, 120000);
            });
        }

        function stopAll() {
            clearInterval(STATE.timerId);
            STATE.timerId = null;
            stopSpeechRecognition();
            if (window.speechSynthesis) window.speechSynthesis.cancel();
            STATE.isTTSPlaying = false;
            STATE.isWarmupTTSPlaying = false;
            STATE.part2_2_tts_playing = false;
            STATE.ttsUtterance = null;
            dom.phaseTimer.classList.remove('warning');
            if (STATE.mediaRecorder && STATE.mediaRecorder.state === 'recording') STATE.mediaRecorder.stop();
        }

