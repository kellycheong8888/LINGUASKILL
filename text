        async function requestMicrophone() {
            try {
                if (STATE.globalStream) {
                    const tracks = STATE.globalStream.getTracks();
                    if (tracks.length > 0 && tracks.some(t => t.readyState === 'live')) return true;
                    STATE.globalStream.getTracks().forEach(t => t.stop());
                    STATE.globalStream = null;
                }
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                STATE.globalStream = stream;
                STATE.micReady = true;
                updateMicStatus('✅ Microphone authorized (one-time)', '');
                return true;
            } catch (err) {
                console.error('Microphone error:', err);
                STATE.micReady = false;
                updateMicStatus('❌ Microphone authorization failed: ' + err.message, 'error');
                return false;
            }
        }

        function getAudioStream() {
            if (!STATE.globalStream) {
                console.warn('No global stream available');
                return null;
            }
            return STATE.globalStream;
        }

        function updateMicStatus(text, type) {
            const el = document.getElementById('micStatus');
            if (el) {
                el.textContent = text;
                el.className = 'mic-status' + (type === 'error' ? ' error' : '');
            }
        }

