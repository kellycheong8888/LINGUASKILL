                if (btn) { btn.disabled = false;
                    btn.textContent = '▶ Start Test'; }
                updateMicStatus('✅ Microphone authorized (one-time)', '');
                onStartTest();
            } else {
                showManualRetryButton('Authorization failed, please retry');
