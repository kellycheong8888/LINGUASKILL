        window.manualStartRecording = function(phaseKey) {
            console.log('Manual recording triggered for:', phaseKey);
            const container = document.getElementById('errorContainer');
            if (container) container.innerHTML = '';

            STATE.isAutoRecordTriggered = false;
            STATE.hasAutoAdvanced = false;
            STATE.manualRetry = true;

            const btn = document.getElementById('recordBtn');
            const status = document.getElementById('recordStatus');
            if (btn) { btn.className = 'action-btn recording';
                btn.disabled = false;
                btn.textContent = '🔴 Manual recording...'; }
            if (status) { status.className = 'record-status-text recording';
