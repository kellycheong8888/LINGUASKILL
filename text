                if (progressFill) { progressFill.style.width = '0%';
                    progressFill.classList.remove('warning'); }
                if (btn) { btn.className = 'action-btn done';
                    btn.disabled = true;
                    btn.textContent = '✅ Done'; }
                if (status) { status.className = 'record-status-text done';
                    status.textContent = '✅ Complete'; }
                dom.footerStatus.textContent = '✅ Complete';
                dom.actionCommand.innerHTML = `✓ Question completed<span class="sub">Click "Next" to continue</span>`;
                if (playbackBtn) { playbackBtn.disabled = false;
                    playbackBtn.textContent = '▶ Playback'; }
                if (retryBtn) { retryBtn.disabled = false;
                    retryBtn.textContent = '🔄 Retry'; }
                onWarmupQuestionComplete();
            }, () => {
                showErrorNotice('Auto-recording failed. Please click below to retry manually.', 'warmup');
            });

            startSpeechRecognition('warmup');
        }

        // ✅ FIX: Warm-up Next button now works properly
        function onWarmupQuestionComplete() {
            const total = getPhaseData('warmup').questions.length;
            if (STATE.warmupQuestionIndex < total - 1) {
                STATE.warmupQuestionIndex++;
