                if (retryBtn) { retryBtn.disabled = false;
                    retryBtn.textContent = '🔄 Retry'; }
                onSpeakingComplete(phaseKey);
            }, () => {
                showErrorNotice('Manual recording failed. Please check microphone or refresh.', phaseKey);
            });

            startSpeechRecognition(phaseKey);
        };

        // ============================================================
        //  14. MEDIA RECORDER & PLAYBACK
        // ============================================================

        function startMediaRecording(phaseKey, duration, onComplete, onError) {
            if (STATE.mediaRecorder && STATE.mediaRecorder.state === 'recording') { STATE.mediaRecorder.stop(); }
            STATE.audioChunks = [];
            STATE.audioUrl = null;
            const stream = getAudioStream();
            if (!stream) {
                console.error('No audio stream available');
                dom.footerStatus.textContent = '❌ No microphone stream';
                if (onError) onError();
                if (onComplete) onComplete();
                return;
            }

            try {
                const mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });
                STATE.mediaRecorder = mediaRecorder;
                let hasData = false;

                mediaRecorder.ondataavailable = (event) => {
                    if (event.data.size > 0) {
                        STATE.audioChunks.push(event.data);
                        hasData = true;
                    }
                };

                mediaRecorder.onstop = () => {
                    if (STATE.audioChunks.length > 0 && hasData) {
                        const blob = new Blob(STATE.audioChunks, { type: 'audio/webm' });
                        STATE.audioUrl = URL.createObjectURL(blob);
                        enablePlaybackButton(phaseKey);
                        if (onComplete) onComplete();
                    } else {
                        console.warn('No audio data recorded.');
                        if (onError) onError();
                        if (onComplete) onComplete();
                    }
                };

                mediaRecorder.onerror = (err) => {
                    console.error('MediaRecorder error:', err);
                    if (onError) onError();
                };

                mediaRecorder.start();
                STATE.mediaRecorder = mediaRecorder;
                if (duration > 0) {
                    setTimeout(() => {
                        if (STATE.mediaRecorder && STATE.mediaRecorder.state === 'recording') {
                            STATE.mediaRecorder.stop();
                        }
                    }, duration * 1000 + 200);
                }
            } catch (err) {
                console.error('MediaRecorder error:', err);
                dom.footerStatus.textContent = '❌ Recording start failed';
                if (onError) onError();
                if (onComplete) onComplete();
            }
        }

        function enablePlaybackButton(phaseKey) {
            document.querySelectorAll('.action-btn.playback').forEach(btn => {
                if (btn.id && btn.id.startsWith('playbackBtn')) {
                    btn.disabled = false;
                    btn.textContent = '▶ Playback';
                }
            });
        }

        function togglePlayback(btn, phaseKey, index) {
            if (STATE.isPlaying) {
                if (STATE.audioElement) { STATE.audioElement.pause();
                    STATE.audioElement.currentTime = 0; }
                STATE.isPlaying = false;
                btn.textContent = '▶ Playback';
                btn.classList.remove('playing');
                return;
            }
            if (!STATE.audioUrl) { console.warn('No audio URL to play.'); return; }
            let audio = STATE.audioElement;
            if (!audio) {
                audio = new Audio(STATE.audioUrl);
                STATE.audioElement = audio;
                audio.addEventListener('ended', () => {
                    STATE.isPlaying = false;
                    btn.textContent = '▶ Playback';
                    btn.classList.remove('playing');
                });
            } else {
                if (audio.src !== STATE.audioUrl) { audio.src = STATE.audioUrl;
                    audio.load(); }
            }
            audio.play().then(() => {
                STATE.isPlaying = true;
                btn.textContent = '⏸ Pause';
                btn.classList.add('playing');
            }).catch(err => { console.error('Playback error:', err);
                btn.textContent = '▶ Playback';
                btn.classList.remove('playing'); });
        }

        function revokeAudioUrl() {
            if (STATE.audioUrl) { URL.revokeObjectURL(STATE.audioUrl);
                STATE.audioUrl = null; }
            if (STATE.audioElement) { STATE.audioElement.pause();
                STATE.audioElement.src = '';
                STATE.audioElement = null; }
            STATE.isPlaying = false;
            STATE.audioChunks = [];
            document.querySelectorAll('.action-btn.playback').forEach(btn => {
                btn.textContent = '▶ Playback';
                btn.classList.remove('playing');
                btn.disabled = true;
            });
        }

        // ============================================================
        //  15. RETRY
        // ============================================================

        function retryCurrentPart(phaseKey, index) {
            stopAll();
            revokeAudioUrl();
            STATE.isRetry = true;
            STATE.retryPhaseKey = phaseKey;
            STATE.retryIndex = index !== undefined ? index : null;
            STATE.hasAutoAdvanced = false;
            STATE.isAutoRecordTriggered = false;
            STATE.subPhase = 'idle';
            STATE.manualRetry = false;
            dom.btnNext.disabled = true;
            dom.btnNext.innerHTML = 'Next <span class="arrow">➜</span>';
            dom.phaseTimer.classList.remove('warning');
            dom.actionCommand.innerHTML =
                `🔄 Retrying...<span class="sub">Auto-recording after preparation</span>`;
            dom.footerStatus.textContent = 'Retrying...';

            const container = document.getElementById('errorContainer');
            if (container) container.innerHTML = '';

            if (phaseKey === 'warmup') {
                setTimeout(async () => {
                    if (window.speechSynthesis) window.speechSynthesis.cancel();
                    STATE.isWarmupTTSPlaying = false;
                    STATE.ttsUtterance = null;
                    dom.footerStatus.textContent = 'Retrying... preparing';
                    dom.actionCommand.innerHTML = `🔄 Retry preparing<span class="sub">4s until auto-recording</span>`;
                    await sleep(4000);
                    await playBeep(800, 200, 0.5);
                    dom.actionCommand.innerHTML =
                        `🎤 Retry recording<span class="sub">You have ${getPhaseData('warmup').speakTime}s</span>`;
                    startWarmupAutoRecord();
                }, 500);
            } else if (phaseKey === 'part2_2' && index !== undefined) {
                STATE.questionIndex = index;
                renderPart2_2();
                setTimeout(async () => {
                    if (window.speechSynthesis) window.speechSynthesis.cancel();
                    STATE.part2_2_tts_playing = false;
                    STATE.ttsUtterance = null;
                    dom.footerStatus.textContent = 'Retrying... preparing';
                    dom.actionCommand.innerHTML = `🔄 Retry preparing<span class="sub">4s until auto-recording</span>`;
                    await sleep(4000);
                    await playBeep(800, 200, 0.5);
                    dom.actionCommand.innerHTML =
                        `🎤 Retry recording<span class="sub">You have ${getPhaseData('part2_2').speakTime}s</span>`;
                    startAutoRecord('part2_2');
                }, 600);
            } else if (phaseKey === 'extra') {
                const extraData = getExtraDataByPhase(STATE.phase);
                if (extraData && index !== undefined && index < extraData.length) {
                    renderExtraItem(STATE.phase, index);
                    setTimeout(async () => {
                        dom.actionCommand.innerHTML = `🔄 Retry preparing<span class="sub">4s until auto-recording</span>`;
                        dom.footerStatus.textContent = 'Retrying... preparing';
                        await sleep(4000);
                        await playBeep(800, 200, 0.5);
                        startAutoRecord('extra');
                    }, 600);
                }
            } else {
                const renderMap = { part1: renderPart1, part2_1: renderPart2_1, part3: renderPart3, part4: renderPart4 };
                if (renderMap[phaseKey]) {
                    renderMap[phaseKey]();
                    const data = getPhaseData(phaseKey);
                    if (data && data.prepareTime && data.prepareTime > 0) { startPreparation(phaseKey); } else {
                        setTimeout(async () => {
                            dom.actionCommand.innerHTML = `🔄 Retry preparing<span class="sub">4s until auto-recording</span>`;
                            dom.footerStatus.textContent = 'Retrying... preparing';
                            await sleep(4000);
                            await playBeep(800, 200, 0.5);
                            dom.actionCommand.innerHTML =
                                `🎤 Retry recording<span class="sub">You have ${data.speakTime}s</span>`;
                            startAutoRecord(phaseKey);
                        }, 500);
                    }
                }
            }
        }

        // ============================================================
        //  16. AUTO RECORD
        // ============================================================

        function startAutoRecord(phaseKey) {
            if (STATE.isAutoRecordTriggered && phaseKey !== 'part2_2' && phaseKey !== 'extra') return;
            STATE.isAutoRecordTriggered = true;

            const data = getPhaseData(phaseKey);
            let speakTime = data ? data.speakTime : 20;

            if (phaseKey === 'extra') {
                const extraData = getExtraDataByPhase(STATE.phase);
                if (extraData && STATE.currentExtraIndex >= 0 && STATE.currentExtraIndex < extraData.length) {
                    speakTime = extraData[STATE.currentExtraIndex].speakTime || 60;
                }
            }

            const btn = document.getElementById('recordBtn');
            const status = document.getElementById('recordStatus');
            const progressFill = document.getElementById('recordProgressFill');

            let playbackBtn = null,
                retryBtn = null;
            if (phaseKey === 'warmup') {
                playbackBtn = document.getElementById(getPlaybackBtnId('warmup'));
                retryBtn = document.getElementById(getRetryBtnId('warmup'));
            } else if (phaseKey === 'part2_2') {
                playbackBtn = document.getElementById(getPlaybackBtnId('part2_2', STATE.questionIndex));
                retryBtn = document.getElementById(getRetryBtnId('part2_2', STATE.questionIndex));
            } else if (phaseKey === 'extra') {
                playbackBtn = document.getElementById(getPlaybackBtnId('extra', STATE.currentExtraIndex));
                retryBtn = document.getElementById(getRetryBtnId('extra', STATE.currentExtraIndex));
            } else {
                playbackBtn = document.getElementById(getPlaybackBtnId(phaseKey));
                retryBtn = document.getElementById(getRetryBtnId(phaseKey));
            }

            const total = speakTime || 20;

            dom.actionCommand.innerHTML =
                `<span style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">🔴 Auto-recording<span class="beep-flash">● BEEP</span></span><span class="sub">You have ${total}s to speak</span>`;

            if (btn) { btn.disabled = false;
                btn.className = 'action-btn recording';
                btn.textContent = '🔴 Recording...'; }
            if (status) { status.className = 'record-status-text recording';
                status.textContent = '🔴 Recording... Please speak'; }
            if (playbackBtn) { playbackBtn.disabled = true;
                playbackBtn.textContent = '⏳ Recording'; }
            if (retryBtn) { retryBtn.disabled = true;
                retryBtn.textContent = '⏳ Recording'; }

            setPhase('speak');
            dom.phaseTimer.textContent = formatTime(total);
            dom.phaseTimer.classList.remove('warning');
            dom.footerStatus.textContent = `Recording ${formatTime(total)}s`;

            const container = document.getElementById('errorContainer');
            if (container) container.innerHTML = '';

            startMediaRecording(phaseKey, total, () => {
                dom.phaseTimer.textContent = '00';
                dom.phaseTimer.classList.remove('warning');
                if (progressFill) { progressFill.style.width = '0%';
                    progressFill.classList.remove('warning'); }
                if (btn) { btn.className = 'action-btn done';
                    btn.disabled = true;
                    btn.textContent = '✅ Done'; }
                if (status) { status.className = 'record-status-text done';
                    status.textContent = '✅ Complete'; }
                dom.footerStatus.textContent = '✅ Complete';
                dom.actionCommand.innerHTML = `✓ Recording complete<span class="sub">Click "Next" to continue</span>`;
                if (playbackBtn) { playbackBtn.disabled = false;
                    playbackBtn.textContent = '▶ Playback'; }
                if (retryBtn) { retryBtn.disabled = false;
                    retryBtn.textContent = '🔄 Retry'; }
                onSpeakingComplete(phaseKey);
            }, () => {
                showErrorNotice('Auto-recording failed. Please click below to retry manually.', phaseKey);
            });

            startSpeechRecognition(phaseKey);

            STATE.subPhase = 'speaking';
            STATE.timeRemaining = total;
            STATE.totalTime = total;
            if (progressFill) { progressFill.style.width = '100%';
                progressFill.classList.remove('warning'); }

            clearInterval(STATE.timerId);
            STATE.timerId = setInterval(() => {
                STATE.timeRemaining -= 0.1;
                const display = Math.ceil(STATE.timeRemaining);
                dom.phaseTimer.textContent = formatTime(STATE.timeRemaining);
                dom.phaseTimer.classList.toggle('warning', display <= 10 && display > 0);
                dom.footerStatus.textContent = `Recording ${formatTime(STATE.timeRemaining)}s`;
                if (progressFill) {
                    const pct = total > 0 ? Math.max(0, (STATE.timeRemaining / total) * 100) : 0;
                    progressFill.style.width = pct + '%';
                    progressFill.classList.toggle('warning', STATE.timeRemaining <= 10 && STATE.timeRemaining > 0);
                }
                if (STATE.timeRemaining <= 0) {
                    clearInterval(STATE.timerId);
                    if (STATE.mediaRecorder && STATE.mediaRecorder.state === 'recording') {
                        STATE.mediaRecorder.stop();
                    }
                }
            }, 100);
        }

        // ============================================================
        //  17. onSpeakingComplete
        // ============================================================

        function onSpeakingComplete(phaseKey) {
            if (STATE.hasAutoAdvanced) return;
            STATE.hasAutoAdvanced = true;
            STATE.subPhase = 'done';
            dom.btnNext.disabled = false;
            dom.btnNext.innerHTML = 'Next <span class="arrow">➜</span>';

            let nextPhase = null;
            if (phaseKey === 'part1') { nextPhase = 'part2_1'; } else if (phaseKey === 'part2_1') { nextPhase =
                    'part2_2';
                STATE.questionIndex = 0; } else if (phaseKey === 'part2_2') {
                const data = getPhaseData('part2_2');
                if (STATE.questionIndex < data.questions.length - 1) {
                    STATE.questionIndex++;
                    STATE.isAutoRecordTriggered = false;
                    STATE.hasAutoAdvanced = false;
                    dom.btnNext.disabled = false;
                    dom.btnNext.innerHTML = 'Next ➜ <span class="arrow">➜</span>';
                    dom.btnNext.onclick = () => {
                        dom.btnNext.onclick = null;
                        dom.btnNext.disabled = true;
                        dom.btnNext.innerHTML = 'Next <span class="arrow">➜</span>';
                        revokeAudioUrl();
                        enterPhase('part2_2');
                    };
                    return;
                } else { nextPhase = 'part3';
                    STATE.questionIndex = 0; }
            } else if (phaseKey === 'part3') { nextPhase = 'part4'; } else if (phaseKey === 'part4') { nextPhase =
                    'complete'; } else if (phaseKey === 'extra') {
                const extraData = getExtraDataByPhase(STATE.phase);
                if (extraData && STATE.currentExtraIndex < extraData.length - 1) {
                    STATE.currentExtraIndex++;
                    STATE.isAutoRecordTriggered = false;
                    STATE.hasAutoAdvanced = false;
                    dom.btnNext.disabled = false;
                    dom.btnNext.innerHTML = 'Next ➜ <span class="arrow">➜</span>';
                    dom.btnNext.onclick = () => {
                        dom.btnNext.onclick = null;
                        dom.btnNext.disabled = true;
                        dom.btnNext.innerHTML = 'Next <span class="arrow">➜</span>';
                        revokeAudioUrl();
                        renderExtraItem(STATE.phase, STATE.currentExtraIndex);
                    };
                    return;
                } else {
                    const order = getPartOrder();
                    const currentIdx = order.indexOf(STATE.phase);
                    if (currentIdx >= 0 && currentIdx < order.length - 1) {
                        nextPhase = order[currentIdx + 1];
                    } else { nextPhase = 'complete'; }
                }
            }

            if (nextPhase === 'complete') {
                dom.btnNext.onclick = () => { renderComplete();
                    dom.btnNext.disabled = true; };
                dom.btnNext.innerHTML = 'View Results 🎉';
                dom.btnNext.disabled = false;
                return;
            }
            if (nextPhase) {
                dom.btnNext.onclick = () => {
                    dom.btnNext.onclick = null;
                    dom.btnNext.disabled = true;
                    dom.btnNext.innerHTML = 'Next <span class="arrow">➜</span>';
                    revokeAudioUrl();
                    enterPhase(nextPhase);
                };
            }
        }

        // ============================================================
        //  18. CORE - enterPhase, startPreparation
        // ============================================================

        function enterPhase(phaseKey) {
            stopAll();
            STATE.phase = phaseKey;
            STATE.subPhase = 'idle';
            STATE.hasAutoAdvanced = false;
            STATE.isAutoRecordTriggered = false;
            STATE.manualRetry = false;
            if (STATE.isRetry) { STATE.isRetry = false;
                STATE.retryPhaseKey = null;
                STATE.retryIndex = null; }
            revokeAudioUrl();
            dom.btnNext.disabled = true;
            dom.btnNext.innerHTML = 'Next <span class="arrow">➜</span>';
            dom.phaseTimer.classList.remove('warning');
            dom.phasePointer.classList.remove('hidden');

            const container = document.getElementById('errorContainer');
            if (container) container.innerHTML = '';

            const data = getPhaseData(phaseKey);
            if (data) {
                dom.headerBadge.textContent = data.label || '';
                dom.headerTitle.textContent = data.name || '';
                dom.headerSub.textContent = data.sub || '';
            }

            switch (phaseKey) {
                case 'start':
                    renderStartPage();
                    break;
                case 'part1':
                    renderPart1();
                    break;
                case 'part2_1':
                    renderPart2_1();
                    break;
                case 'part2_2':
                    renderPart2_2();
                    break;
                case 'part3':
                    renderPart3();
                    break;
                case 'part4':
                    renderPart4();
                    break;
                default:
                    break;
            }
        }

        function startPreparation(phaseKey) {
            const data = getPhaseData(phaseKey);
            if (!data || data.prepareTime <= 0) { startAutoRecord(phaseKey); return; }

            STATE.subPhase = 'thinking';
            STATE.timeRemaining = data.prepareTime;
            STATE.totalTime = data.prepareTime;
            STATE.isAutoRecordTriggered = false;

            dom.phaseTimer.textContent = formatTime(data.prepareTime);
            dom.phaseTimer.classList.remove('warning');
            setPhase('think');
            dom.footerStatus.textContent = `Thinking ${formatTime(data.prepareTime)}s`;

            const btn = document.getElementById('recordBtn');
            const status = document.getElementById('recordStatus');
            const progressFill = document.getElementById('recordProgressFill');

            if (btn) { btn.disabled = true;
