                        btn.textContent = '✅ Played';
                        if (dot) dot.classList.remove('playing');
                        if (statusText) statusText.textContent = '✅ Complete';
                        dom.footerStatus.textContent = 'Audio complete';
                        dom.actionCommand.innerHTML =
                            `⏳ Preparing...<span class="sub">4s until auto-recording</span>`;
                        dom.footerStatus.textContent = 'Preparing... 4s';
                        await sleep(4000);
                        await playBeep(800, 200, 0.5);
                        dom.actionCommand.innerHTML =
                            `🎤 Auto-recording<span class="sub">You have ${speakTime}s to summarise</span>`;
                        STATE.phase = phaseKey;
                        startAutoRecord('extra');
                    }).catch(async () => {
                        btn.textContent = '▶ Replay';
                        btn.disabled = false;
                        if (dot) dot.classList.remove('playing');
                        if (statusText) statusText.textContent = '⚠️ Error';
                        await playBeep(800, 200, 0.5);
                        STATE.phase = phaseKey;
                        startAutoRecord('extra');
                    });
                });
            }
        }

        // ============================================================
        //  23. EXTRA PREPARATION
        // ============================================================

        function startExtraPreparation(phaseKey, prepareTime, speakTime) {
            const btn = document.getElementById('recordBtn');
            const status = document.getElementById('recordStatus');
            const progressFill = document.getElementById('recordProgressFill');

            STATE.subPhase = 'thinking';
            STATE.timeRemaining = prepareTime;
            STATE.totalTime = prepareTime;
            STATE.isAutoRecordTriggered = false;

            dom.phaseTimer.textContent = formatTime(prepareTime);
            dom.phaseTimer.classList.remove('warning');
            setPhase('think');
            dom.footerStatus.textContent = `Thinking ${formatTime(prepareTime)}s`;

            if (btn) { btn.disabled = true;
                btn.textContent = `⏳ Thinking ${formatTime(prepareTime)}s`; }
            if (status) status.textContent = `⏳ Thinking... ${prepareTime}s remaining`;
            if (progressFill) { progressFill.style.width = '100%';
                progressFill.classList.remove('warning'); }

            dom.actionCommand.innerHTML =
                `📝 Planning your answer<span class="sub">⏱ You have ${prepareTime}s to prepare</span>`;

            clearInterval(STATE.timerId);
            STATE.timerId = setInterval(() => {
                STATE.timeRemaining -= 0.1;
                const display = Math.ceil(STATE.timeRemaining);
                dom.phaseTimer.textContent = formatTime(STATE.timeRemaining);
                dom.phaseTimer.classList.toggle('warning', display <= 10 && display > 0);
                dom.footerStatus.textContent = `Thinking ${formatTime(STATE.timeRemaining)}s`;
                if (progressFill) {
                    const pct = prepareTime > 0 ? Math.max(0, (STATE.timeRemaining / prepareTime) * 100) : 0;
                    progressFill.style.width = pct + '%';
                    progressFill.classList.toggle('warning', STATE.timeRemaining <= 10 && STATE.timeRemaining > 0);
                }
                const btn2 = document.getElementById('recordBtn');
                if (btn2 && btn2.disabled) { btn2.textContent = `⏳ Thinking ${formatTime(STATE.timeRemaining)}s`; }
                if (STATE.timeRemaining <= 0) {
                    clearInterval(STATE.timerId);
                    dom.phaseTimer.textContent = '00';
                    dom.phaseTimer.classList.remove('warning');
                    if (progressFill) { progressFill.style.width = '0%';
                        progressFill.classList.remove('warning'); }
                    dom.footerStatus.textContent = 'Ready to speak';
                    if (!STATE.isAutoRecordTriggered) {
                        playBeep(800, 200, 0.5).then(() => {
                            STATE.phase = phaseKey;
                            startAutoRecord('extra');
                        });
                    }
                }
            }, 100);
        }

        // ============================================================
        //  24. COMPLETE
        // ============================================================

        function renderComplete() {
            dom.contentArea.innerHTML = `
                <div class="complete-wrap">
                    <div class="icon">🎉</div>
                    <h2>Test Complete!</h2>
                    <p>You have completed <strong>${getCurrentSet().label}</strong> - ${getCurrentSet().desc}</p>
                    <p style="font-size:0.9rem;color:#5a6c7e;">6 Complete Sets + Extra Library · Click Close to return</p>
                    <button class="btn-close" onclick="location.reload()">Close</button>
                </div>
            `;
            dom.headerBadge.textContent = 'Done';
            dom.headerTitle.textContent = 'Complete';
            dom.headerSub.textContent = '';
            dom.headerProgress.textContent = '🎉 Finished';
            dom.actionCommand.innerHTML = '🎉 Test complete!';
            dom.phaseTimer.textContent = '✓';
            dom.phaseTimer.classList.remove('warning');
            dom.btnNext.disabled = true;
            dom.btnNext.innerHTML = 'Complete ✓';
            dom.footerStatus.textContent = 'Finished';
            setPhase('idle');
            dom.phasePointer.classList.add('hidden');
            dom.dotIndicator.querySelectorAll('span').forEach(d => d.className = 'completed');
            revokeAudioUrl();
        }

        // ============================================================
        //  25. INIT
        // ============================================================

        function init() {
            if (!window.SpeechRecognition && !window.webkitSpeechRecognition) {
                const note = document.createElement('div');
                note.style.cssText =
                    'background:#fff3e0;padding:10px 16px;border-radius:10px;margin-top:12px;color:#a8670e;font-size:0.85rem;border:1px solid #f7e3b6;text-align:center;';
                note.textContent = '💡 Speech recognition not available, but recording and playback still work.';
                document.querySelector('.content-area').appendChild(note);
            }
            renderStartPage();
        }

        document.addEventListener('DOMContentLoaded', init);
        window.addEventListener('beforeunload', function() {
            stopAll();
            revokeAudioUrl();
            if (STATE.globalStream) { STATE.globalStream.getTracks().forEach(t => t.stop());
                STATE.globalStream = null; }
        });
    </script>
</body>
</html>
