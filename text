
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Linguaskill Business - 6 Sets + 题库</title>
    <style>
        /* ============================================================
           Global Reset & Base
           ============================================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #2d3a4a;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 24px;
            color: #1d2b3e;
        }

        .container {
            max-width: 1100px;
            width: 100%;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
            padding: 28px 32px 24px;
            transition: all 0.2s ease;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 12px;
            border-bottom: 1px solid #dce1e8;
            flex-wrap: wrap;
            gap: 8px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .brand {
            font-size: 1rem;
            font-weight: 700;
            color: #002b54;
        }
        .brand sup {
            font-size: 0.5rem;
            font-weight: 400;
            color: #5a6c7e;
            top: -0.6em;
        }
        .brand .light {
            font-weight: 300;
            color: #2a4058;
        }

        .badge {
            background: #002b54;
            color: #fff;
            font-weight: 700;
            font-size: 0.75rem;
            padding: 4px 14px;
            border-radius: 30px;
            letter-spacing: 0.3px;
        }

        .part-title {
            font-size: 1rem;
            font-weight: 600;
            color: #1d2b3e;
        }

        .part-sub {
            font-size: 0.8rem;
            color: #5a6c7e;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .header-progress {
            font-size: 0.8rem;
            color: #5a6c7e;
        }

        .phase-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 14px 0 18px;
            padding: 6px 14px;
            background: #eef1f5;
            border-radius: 30px;
            border: 1px solid #dce1e8;
        }

        .phase-bar .label {
            font-size: 0.65rem;
            font-weight: 600;
            color: #5a6c7e;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .phase-bar .label.active {
            color: #002b54;
        }

        .phase-track {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 4px;
            height: 6px;
            background: #c8d0d9;
            border-radius: 4px;
            position: relative;
        }

        .phase-track .seg {
            flex: 1;
            height: 100%;
            border-radius: 4px;
            background: #c8d0d9;
            transition: background 0.4s;
        }
        .phase-track .seg.active-listen {
            background: #0055a4;
        }
        .phase-track .seg.active-think {
            background: #f5a623;
        }
        .phase-track .seg.active-speak {
            background: #1e8e3e;
        }

        .phase-track .pointer {
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-top: 12px solid #002b54;
            transition: left 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .phase-track .pointer.hidden {
            display: none;
        }

        .phase-timer {
            font-size: 1.2rem;
            font-weight: 700;
            color: #002b54;
            min-width: 44px;
            text-align: right;
            font-variant-numeric: tabular-nums;
        }
        .phase-timer.warning {
            color: #d32f2f;
            animation: pulse 0.8s ease-in-out infinite;
        }

        @keyframes pulse {
            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }
            50% {
                opacity: 0.5;
                transform: scale(1.06);
            }
        }

        .action-command {
            font-size: 1.3rem;
            font-weight: 700;
            color: #002b54;
            margin-bottom: 14px;
            padding-bottom: 6px;
            border-bottom: 3px solid #f5a623;
            line-height: 1.3;
        }
        .action-command .sub {
            display: block;
            font-size: 0.85rem;
            font-weight: 400;
            color: #5a6c7e;
            margin-top: 2px;
        }

        .content-area {
            min-height: 240px;
            background: #fafcfe;
            border-radius: 16px;
            padding: 20px 24px;
            border: 1px solid #dce1e8;
            margin-bottom: 18px;
            transition: background 0.2s;
        }

        .start-page {
            text-align: center;
            padding: 20px 10px 10px;
        }
        .start-page .icon {
            font-size: 3.2rem;
            margin-bottom: 10px;
        }
        .start-page h1 {
            font-size: 1.8rem;
            font-weight: 700;
            color: #002b54;
            margin-bottom: 4px;
        }
        .start-page .subtitle {
            font-size: 1rem;
            color: #5a6c7e;
            margin-bottom: 12px;
        }
        .start-page .set-selector {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin: 12px 0 16px;
            flex-wrap: wrap;
        }
        .start-page .set-btn {
            padding: 6px 16px;
            border: 2px solid #dce1e8;
            border-radius: 30px;
            background: #fff;
            font-weight: 700;
            font-size: 0.85rem;
            color: #5a6c7e;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .start-page .set-btn:hover {
            border-color: #002b54;
            color: #002b54;
        }
        .start-page .set-btn.active {
            border-color: #002b54;
            background: #002b54;
            color: #fff;
        }
        .start-page .set-desc {
            font-size: 0.85rem;
            color: #5a6c7e;
            margin-bottom: 14px;
            min-height: 24px;
        }
        .start-page .info-box {
            background: #f7fafc;
            border-radius: 12px;
            padding: 14px 20px;
            text-align: left;
            max-width: 620px;
            margin: 0 auto 20px;
            border: 1px solid #dce1e8;
            line-height: 1.8;
            font-size: 0.88rem;
            color: #1d2b3e;
        }
        .start-page .info-box ul {
            padding-left: 20px;
            margin: 4px 0;
        }
        .start-page .info-box ul li {
            margin-bottom: 2px;
        }
        .start-page .btn-start {
            padding: 12px 48px;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1.1rem;
            background: #002b54;
            color: #fff;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 4px 16px rgba(0, 43, 84, 0.25);
            letter-spacing: 0.5px;
        }
        .start-page .btn-start:hover {
            background: #001a33;
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 43, 84, 0.35);
        }
        .start-page .btn-start:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }
        .start-page .mic-status {
            font-size: 0.85rem;
            color: #1e8e3e;
            margin-top: 8px;
        }
        .start-page .mic-status.error {
            color: #d32f2f;
        }

        .two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            align-items: start;
        }

        .col-left .task-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #002b54;
            margin-bottom: 6px;
        }

        .col-left .task-body {
            font-size: 0.95rem;
            line-height: 1.8;
            color: #1d2b3e;
        }
        .col-left .task-body ul,
        .col-left .task-body ol {
            padding-left: 20px;
            margin: 4px 0 8px;
        }
        .col-left .task-body li {
            margin-bottom: 3px;
        }
        .col-left .task-body .subnote {
            color: #5a6c7e;
            font-size: 0.82rem;
            margin-top: 6px;
        }
        .col-left .task-body .sample-answer {
            background: #f0f6fe;
            padding: 12px 16px;
            border-radius: 10px;
            border-left: 4px solid #002b54;
            margin: 8px 0;
            font-size: 0.9rem;
            line-height: 1.8;
            color: #1d2b3e;
            max-height: 300px;
            overflow-y: auto;
        }
        .col-left .task-body .sample-answer .label {
            font-weight: 700;
            color: #002b54;
            font-size: 0.8rem;
        }

        .col-right {
            background: #f7faff;
            border-radius: 12px;
            padding: 14px 16px;
            border: 1px solid #dce1e8;
        }
        .col-right .chart-title {
            font-weight: 600;
            color: #002b54;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }
        .col-right .tip-text {
            font-size: 0.88rem;
            line-height: 1.7;
            color: #1d2b3e;
        }
        .col-right .tip-text ul {
            padding-left: 18px;
            margin: 4px 0;
        }
        .col-right .tip-text ul li {
            margin-bottom: 2px;
        }

        .chat-column {
            background: #f7fafc;
            border-radius: 14px;
            padding: 14px 16px 10px;
            border: 1px solid #dce1e8;
        }
        .chat-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid #dce1e8;
        }
        .chat-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #002b54;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
        }
        .chat-name {
            font-weight: 600;
            color: #1d2b3e;
            font-size: 0.9rem;
        }
        .chat-status {
            font-size: 0.7rem;
            color: #5a6c7e;
            margin-left: auto;
        }
        .message {
            margin-bottom: 8px;
        }
        .message .time {
            font-size: 0.6rem;
            color: #5a6c7e;
            font-weight: 500;
        }
        .message .bubble {
            background: #e3ecf5;
            padding: 8px 14px;
            border-radius: 12px 12px 12px 4px;
            font-size: 0.85rem;
            line-height: 1.6;
            color: #1d2b3e;
            margin-top: 2px;
            border-left: 3px solid #002b54;
        }
        .message .bubble .highlight {
            background: #fff8e1;
            padding: 0 4px;
            border-radius: 3px;
            font-weight: 600;
        }

        .brochure-column {
            background: #ffffff;
            border-radius: 14px;
            padding: 14px 16px 10px;
            border: 1px solid #dce1e8;
        }
        .brochure-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #002b54;
            margin-bottom: 2px;
        }
        .brochure-sub {
            font-size: 0.75rem;
            color: #5a6c7e;
            margin-bottom: 10px;
            padding-bottom: 6px;
            border-bottom: 1px solid #dce1e8;
        }
        .section-label {
            font-weight: 600;
            font-size: 0.8rem;
            color: #1d2b3e;
            margin: 8px 0 4px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .section-label:first-of-type {
            margin-top: 0;
        }
        .service-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            margin-bottom: 2px;
        }
        .service-card {
            background: #f7fafc;
            border-radius: 8px;
            padding: 6px 10px;
            border: 1px solid #dce1e8;
        }
        .service-card .name {
            font-weight: 700;
            font-size: 0.78rem;
            color: #002b54;
            margin-bottom: 2px;
        }
        .service-card .feature {
            font-size: 0.7rem;
            line-height: 1.5;
            color: #1d2b3e;
            padding: 1px 0;
        }
        .eval-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.75rem;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 2px;
        }
        .eval-table th {
            background: #002b54;
            color: #fff;
            padding: 4px 8px;
            text-align: left;
            font-weight: 600;
            font-size: 0.68rem;
        }
        .eval-table td {
            padding: 4px 8px;
            border-bottom: 1px solid #dce1e8;
            background: #fafcfe;
        }
        .eval-table tr:last-child td {
            border-bottom: none;
        }
        .eval-table .dimension {
            font-weight: 600;
            color: #1d2b3e;
            font-size: 0.72rem;
        }
        .eval-table .stars {
            color: #f5a623;
            letter-spacing: 0.5px;
            font-size: 0.72rem;
        }
        .eval-table .score {
            font-weight: 600;
            color: #002b54;
            font-size: 0.68rem;
        }
        .eval-table .tag {
            font-size: 0.58rem;
            font-weight: 600;
            padding: 1px 6px;
            border-radius: 12px;
            margin-left: 4px;
        }
        .eval-table .tag.premium {
            color: #d32f2f;
            background: #ffebee;
        }
        .eval-table .tag.lowcost {
            color: #1e8e3e;
            background: #e8f5e9;
        }
        .feedback-section {
            background: #f7fafc;
            border-radius: 8px;
            padding: 6px 10px;
            margin: 4px 0 2px;
            border: 1px solid #dce1e8;
        }
        .feedback-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.68rem;
        }
        .feedback-table td {
            padding: 2px 4px;
            border-bottom: 1px solid #e8ecf0;
        }
        .feedback-table tr:last-child td {
            border-bottom: none;
        }
        .feedback-table .flabel {
            font-weight: 500;
            color: #1d2b3e;
            font-size: 0.68rem;
        }
        .feedback-table .bar-wrap {
            display: flex;
            align-items: center;
            gap: 3px;
        }
        .feedback-table .bar {
            flex: 1;
            height: 4px;
            background: #dce1e8;
            border-radius: 4px;
            overflow: hidden;
            min-width: 20px;
        }
        .feedback-table .bar .fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.6s;
        }
        .feedback-table .bar .fill.green {
            background: #1e8e3e;
        }
        .feedback-table .bar .fill.yellow {
            background: #f5a623;
        }
        .feedback-table .bar .fill.red {
            background: #d32f2f;
        }
        .feedback-table .pct {
            font-weight: 600;
            font-size: 0.62rem;
            min-width: 20px;
            text-align: right;
        }
        .feedback-table .pct.green {
            color: #1e8e3e;
        }
        .feedback-table .pct.yellow {
            color: #f5a623;
        }
        .feedback-table .pct.red {
            color: #d32f2f;
        }
        .requirements-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2px 12px;
            padding: 4px 2px;
        }
        .requirements-list .item {
            font-size: 0.7rem;
            line-height: 1.5;
            color: #1d2b3e;
        }
        .outcome-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            gap: 4px;
            margin-top: 2px;
        }
        .outcome-item {
            background: #eef6fe;
            border-radius: 8px;
            padding: 4px 2px;
            text-align: center;
            border: 1px solid #dce1e8;
        }
        .outcome-item .oicon {
            font-size: 0.9rem;
        }
        .outcome-item .ovalue {
            font-weight: 700;
            color: #002b54;
            font-size: 0.85rem;
        }
        .outcome-item .odesc {
            font-size: 0.55rem;
            color: #5a6c7e;
            line-height: 1.2;
        }

        .record-section {
            margin-top: 14px;
            padding: 12px 16px;
            background: #f7fafc;
            border-radius: 12px;
            border: 1px solid #dce1e8;
        }

        .record-row {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .record-status-text {
            font-size: 0.82rem;
            color: #5a6c7e;
        }
        .record-status-text.recording {
            color: #d32f2f;
            font-weight: 600;
        }
        .record-status-text.done {
            color: #1e8e3e;
            font-weight: 600;
        }
        .record-status-text.error {
            color: #d32f2f;
            font-weight: 600;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 14px;
            border-radius: 40px;
            border: none;
            font-weight: 600;
            font-size: 0.78rem;
            background: #002b54;
            color: #fff;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 2px 6px rgba(0, 43, 84, 0.15);
            min-width: 80px;
            justify-content: center;
        }
        .action-btn:hover:not(:disabled) {
            background: #001a33;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 43, 84, 0.2);
        }
        .action-btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        .action-btn.recording {
            background: #d32f2f;
            animation: btn-pulse 1s ease-in-out infinite;
        }
        .action-btn.recording:hover:not(:disabled) {
            background: #b71c1c;
        }
        @keyframes btn-pulse {
            0%,
            100% {
                opacity: 1;
            }
            50% {
                opacity: 0.7;
            }
        }
        .action-btn.done {
            background: #1e8e3e;
            cursor: default;
        }
        .action-btn.done:hover {
            background: #1e8e3e;
            transform: none;
        }
        .action-btn.secondary {
            background: #dce1e8;
            color: #1d2b3e;
            box-shadow: none;
            min-width: 60px;
        }
        .action-btn.secondary:hover:not(:disabled) {
            background: #c8cfd9;
        }
        .action-btn.playback {
            background: #2e7d32;
            min-width: 70px;
        }
        .action-btn.playback:hover:not(:disabled) {
            background: #1b5e20;
        }
        .action-btn.playback.playing {
            background: #f57c00;
        }
        .action-btn.playback.playing:hover:not(:disabled) {
            background: #e65100;
        }
        .action-btn.retry {
            background: #e65100;
            min-width: 70px;
        }
        .action-btn.retry:hover:not(:disabled) {
            background: #bf360c;
        }
        .action-btn.retry.retrying {
            background: #f57c00;
            animation: btn-pulse 1s ease-in-out infinite;
        }
        .action-btn.manual-record {
            background: #1565c0;
            min-width: 100px;
            animation: none;
        }
        .action-btn.manual-record:hover:not(:disabled) {
            background: #0d47a1;
        }

        .record-progress {
            margin-top: 6px;
            width: 100%;
            height: 4px;
            background: #dce1e8;
            border-radius: 4px;
            overflow: hidden;
        }
        .record-progress .fill {
            height: 100%;
            width: 100%;
            background: #002b54;
            border-radius: 4px;
            transition: width 0.3s ease, background 0.3s ease;
        }
        .record-progress .fill.warning {
            background: #d32f2f;
        }

        .speech-box {
            margin: 8px 0 2px;
        }
        .speech-box textarea {
            width: 100%;
            min-height: 48px;
            padding: 6px 12px;
            border: 2px solid #dce1e8;
            border-radius: 10px;
            font-size: 0.85rem;
            font-family: inherit;
            resize: vertical;
            background: #ffffff;
            transition: border-color 0.25s;
            color: #1d2b3e;
            line-height: 1.5;
        }
        .speech-box textarea:focus {
            outline: none;
            border-color: #002b54;
            box-shadow: 0 0 0 3px rgba(0, 43, 84, 0.08);
        }
        .speech-box textarea::placeholder {
            color: #aab8c7;
        }

        .playback-hint {
            font-size: 0.6rem;
            color: #5a6c7e;
            margin-left: 2px;
        }

        .extra-library {
            margin-top: 12px;
            border-top: 2px dashed #dce1e8;
            padding-top: 12px;
        }
        .extra-library .toggle-btn {
            background: none;
            border: none;
            color: #002b54;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            padding: 4px 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .extra-library .toggle-btn:hover {
            color: #001a33;
        }
        .extra-library .library-content {
            display: none;
            margin-top: 8px;
            max-height: 400px;
            overflow-y: auto;
        }
        .extra-library .library-content.open {
            display: block;
        }
        .extra-library .library-item {
            padding: 6px 12px;
            margin: 3px 0;
            background: #f7fafc;
            border-radius: 8px;
            border-left: 3px solid #dce1e8;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.82rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .extra-library .library-item:hover {
            background: #eef1f5;
