            const btn = document.getElementById('btnStartTest');
            btn.disabled = true;
            btn.textContent = '⏳ Requesting microphone...';
            updateMicStatus('⏳ Requesting microphone (one-time)...', '');

            const micOk = await requestMicrophone();
            if (!micOk) {
                btn.disabled = false;
                btn.textContent = '▶ Retry (microphone required)';
                STATE.isStarted = false;
                updateMicStatus('❌ Microphone required to start test', 'error');
                showManualRetryButton('Click below to retry microphone authorization');
                return;
            }

            dom.actionCommand.innerHTML = `Starting test...<span class="sub">🔊 Preparing BEEP</span>`;
            dom.footerStatus.textContent = 'Starting...';
            dom.headerBadge.textContent = 'Warm-up';
            dom.headerProgress.textContent = 'Question 1/3';

            await playBeep(880, 300, 0.6);
            await sleep(300);

            dom.actionCommand.innerHTML = `Test started!<span class="sub">🎤 Warm-up questions will be read aloud</span>`;
            STATE.warmupQuestionIndex = 0;
            dom.btnNext.innerHTML = 'Next <span class="arrow">➜</span>';
